{
  "name": "jouska-monorepo",
  "private": true,
  "type": "module",
  "description": "jouska monorepo: the library and its reference Cloudflare Worker.",
  "license": "MIT",
  "author": "Shangxin <shangxin@outlook.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YoungSx/jouska.git"
  },
  "bugs": {
    "url": "https://github.com/YoungSx/jouska/issues"
  },
  "homepage": "https://github.com/YoungSx/jouska#readme",
  "workspaces": [
    "packages/*",
    "workers/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "cf:setup": "node scripts/cf-setup.mjs",
    "check": "npm run lint && npm run format:check && npm run build && npm run typecheck && npm run test"
  },
  "devDependencies": {
    "oxlint": "^1.80.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260815.1": true,
    "workerd@1.20260825.1": true
  }
}
