{
  "name": "veilo",
  "version": "0.0.0",
  "description": "Reverse-proxy middleware for Hono on Cloudflare Workers.",
  "license": "MIT",
  "author": "Shangxin <shangxin@outlook.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/YoungSx/veilo.git"
  },
  "bugs": {
    "url": "https://github.com/YoungSx/veilo/issues"
  },
  "homepage": "https://github.com/YoungSx/veilo#readme",
  "keywords": [
    "hono",
    "cloudflare-workers",
    "reverse-proxy",
    "middleware",
    "edge"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test && npm run build",
    "prepublishOnly": "node -e \"console.error('publishing is disabled: the package name is not final yet \u2014 see scripts.prepublishOnly'); process.exit(1)\""
  },
  "peerDependencies": {
    "hono": "^4.13.5"
  },
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260826.1",
    "oxlint": "^1.80.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.126.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260815.1": true,
    "workerd@1.20260825.1": true
  }
}
