{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "jouska",
  "main": "index.ts",
  "compatibility_date": "2026-08-15",
  // Gives the deployment a <name>.<subdomain>.workers.dev URL.
  "workers_dev": true,
  "observability": { "enabled": true },

  // Route table for deployments without a KV namespace. Replace the upstream, or
  // bind a KV namespace and store the document there instead.
  "vars": {
    "JOUSKA_CONFIG": {
      "version": 1,
      "routes": [
        {
          "id": "example",
          "match": { "path": "/" },
          "upstream": "example.com",
          "rewriteHeaders": true,
        },
      ],
    },
    // Optional: one structured JSON log line per proxied request, picked up by
    // Workers Logs because `observability` is enabled. Delete to turn off.
    "ACCESS_LOGS": "true",
  },

  // Optional Analytics Engine receiver: one data point per proxied request,
  // queryable per route for latency percentiles and error/timeout rates.
  // Analytics Engine needs no namespace id; uncomment to enable.
  // "analytics_engine_datasets": [{ "binding": "ANALYTICS" }],

  // Uncomment and fill in a namespace id to serve the route table from KV,
  // which is editable at runtime without redeploying.
  // "kv_namespaces": [{ "binding": "CONFIG", "id": "<namespace-id>" }],
}
