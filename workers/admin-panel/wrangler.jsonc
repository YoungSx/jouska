{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jouska-admin-panel",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",

  // Static assets: the admin SPA. `single-page-application` makes every
  // unmatched GET fall back to index.html so client-side routing works.
  // `run_worker_first` keeps API and MCP traffic off the asset path entirely.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/mcp"],
  },

  // Source of truth for config, users, sessions, audit log.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jouska-admin",
      "database_id": "REPLACE_WITH_REAL_D1_ID",
      "migrations_dir": "migrations",
    },
  ],

  // Compiled config snapshot the reverse proxy reads on its hot path.
  // Admin panel writes; reverse proxy binds the same namespace read-only.
  "kv_namespaces": [
    {
      "binding": "CONFIG_KV",
      "id": "REPLACE_WITH_REAL_KV_ID",
    },
  ],

  // Hostname discovery (the 「域名」screen) reads two values that are deliberately
  // NOT in this file, because this file is tracked by git:
  //
  //   CF_ACCOUNT_ID  — identifies the account. `npm run cf:setup` writes it to
  //                    the git-ignored .dev.vars for local runs; deployments
  //                    take it from CI's own CLOUDFLARE_ACCOUNT_ID.
  //   CF_API_TOKEN   — a secret. `wrangler secret put CF_API_TOKEN`, with READ
  //                    scopes only: Workers Scripts Read covers workers.dev and
  //                    Custom Domains, plus Zone Read and Workers Routes Read
  //                    for zone routes. A write-scoped token here would turn a
  //                    panel compromise into account-wide reconfiguration.
  //
  // Both optional: without them the screen explains what to set instead of
  // erroring, and every other screen works. PROXY_SCRIPT_NAME overrides the
  // proxy's script name when it is not the reference "jouska"; it is not
  // account-specific, so it can be set here.

  // Sign-in. Setting both of these turns Cloudflare Access on for the panel;
  // neither is a secret, and neither is written here, because this file is
  // tracked by git and both values are account-specific:
  //
  //   ACCESS_TEAM  — the `<team>` in `<team>.cloudflareaccess.com`.
  //   ACCESS_AUD   — the Access audience (AUD) tag: shown in the modal when
  //                  you enable Cloudflare Access on the Worker (Settings →
  //                  Access). Worker-level Access covers the workers.dev
  //                  hostname too, so no separate self-hosted app is needed.
  //
  // CI deploys with both from GitHub secrets (see .github/workflows/deploy.yml);
  // locally put them in the git-ignored .dev.vars. Both or neither: a team
  // without an audience would verify that a token was signed by the right
  // organisation but not that it was issued for *this* application.
  //
  // For local development, Access also needs a simulated identity, because
  // `wrangler dev` never receives the real header. Add this block with your own
  // application's aud (it cannot live here for the same reason as above):
  //
  //   "access": { "dev": { "aud": "<ACCESS_AUD>",
  //                        "identity": { "email": "you@example.com" } } }
  //
  // Remove the block to exercise the unauthenticated path.

  // Provisioning policy for addresses Access admits that `users` has never
  // heard of. Not a secret and not account-specific — a repo-level policy
  // choice, which is why it lives here rather than in CI secrets: tightening it
  // is a reviewed change, not a silent one.
  //
  //   "admin"  — equal-footing phase: every admitted address gets a row at
  //              admin, the deliberate posture while there is no delegation
  //              story. Any teammate who passes Access runs the panel.
  //   "viewer" — progressive phase: arrivals get read-only rows; promote from
  //              the users screen. Flipping this line is the entire
  //              changeover between the phases — same table, no migration.
  //   absent   — founding posture: unknown addresses are refused (`403
  //              no_panel_account`) and added from the users screen.
  //
  // Anything else — a typo — fails closed like absent, logged loudly. Whatever
  // this says, the first caller through an empty table always bootstraps as
  // admin: an out-of-band wipe is recovery, never a lockout.
  //
  // Currently absent: recovery is the deploy pipeline's provision window (a
  // 7-day, single-use grant opened only while no enabled admin exists — see
  // deploy.yml), not a standing equal-footing policy. Anyone new is added from
  // the users screen.
  "vars": {},

  "observability": {
    "enabled": true,
  },
}
