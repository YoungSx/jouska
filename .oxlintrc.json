{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "warn"
  },
  "env": { "worker": true, "es2022": true },
  "ignorePatterns": ["dist", "node_modules"],
  "overrides": [
    {
      "files": ["test/**/*.ts"],
      "rules": {
        "unicorn/consistent-function-scoping": "off"
      }
    }
  ]
}
